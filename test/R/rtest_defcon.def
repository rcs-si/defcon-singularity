%setup
    # rsync -rL dereferences cyclic symlinks that break %%files cp -r
    mkdir -p ${SINGULARITY_ROOTFS}/share/pkg.8/r/4.5.2/install
    rsync -rL /share/pkg.8/r/4.5.2/install/ ${SINGULARITY_ROOTFS}/share/pkg.8/r/4.5.2/install/

%post
    yum -y update
    yum -y install python3 python3-pip

